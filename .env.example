# ============================================================================
# KIRA environment configuration
# ============================================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — SHARED knowledge base (non-personal web knowledge only)
# ----------------------------------------------------------------------------
# Personal conversations, names, preferences, tasks and private notes stay
# LOCAL (kira_memory.db). Only public web research is stored in Supabase.
#
# Find both values in: Supabase Dashboard -> Project Settings -> API
#
#   SUPABASE_URL        = Project URL
#   SUPABASE_ANON_KEY   = "anon" / "public" key (safe for client apps)

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# SECURITY: KIRA only ever uses the PUBLIC anon key above.
# DO NOT add SUPABASE_SERVICE_ROLE_KEY here or anywhere else — it bypasses
# Row Level Security and must never be used by, or exposed to, KIRA.
