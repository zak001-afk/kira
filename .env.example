# ============================================================================
# KIRA environment configuration
# ============================================================================
# Copy this file to `.env` and fill in real values:
#
#     cp .env.example .env
#
# `.env` is git-ignored. Never commit real keys.
# ============================================================================

# ----------------------------------------------------------------------------
# Supabase — SHARED knowledge base (non-personal knowledge only)
# ----------------------------------------------------------------------------
# Personal conversations, names, preferences, tasks and private notes stay
# LOCAL in `kira_memory.db`. Only shared web research and shared project
# knowledge are stored in Supabase.
#
# Find both values in: Supabase Dashboard -> Project Settings -> API keys
#
#   SUPABASE_URL       = Project URL
#   SUPABASE_ANON_KEY  = anon / publishable key (safe for client apps)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# Optional: table and SQL function names (defaults match SUPABASE_SCHEMA.sql).
# KIRA_SHARED_KNOWLEDGE_TABLE=shared_knowledge
# KIRA_SHARED_KNOWLEDGE_RPC=search_shared_knowledge

# Optional kill switch. Set to 0/false/off to stop KIRA from talking to
# Supabase completely, even when the keys above are present.
# KIRA_SHARED_KNOWLEDGE=off

# ----------------------------------------------------------------------------
# Gemini — OPTIONAL cloud AI provider (local Ollama stays the default)
# ----------------------------------------------------------------------------
# Cloud AI is OFF unless you explicitly opt in. Personal memory, code and
# screenshots are never sent to a cloud model without explicit approval.
#
# 1. Get a key: https://aistudio.google.com -> "Get API key".
# 2. Opt in AND provide the key (both are required):
# KIRA_CLOUD_AI=1
# GEMINI_API_KEY=your-gemini-api-key
#
# Optional overrides:
# Optional: force a Gemini model name. If the configured/default model is
# rejected by the API (HTTP 404 — names rot over time), KIRA automatically
# discovers a working flash model for your key and switches to it.
# KIRA_GEMINI_MODEL=gemini-2.5-flash
# KIRA_OLLAMA_URL=http://127.0.0.1:11434
# KIRA_OLLAMA_MODEL=qwen3:0.6b

# Chat answer budget in seconds (default 5). Raise it on slow machines.
# With cloud AI enabled, Gemini answers when the local model misses its slot
# (only the current question is sent — never local history or memories).
# KIRA_CHAT_BUDGET=10

# Keyless information tools (weather, holidays): no API key needed, ever.
# KIRA_CITY sets the default city for "weather" with no city named.
# KIRA_COUNTRY sets the default ISO country for public holidays (default TN).
# KIRA_CITY=Nabeul
# KIRA_COUNTRY=TN

# EXPERIMENTAL planner (off by default): when a message is not a known
# command, a model picks ONE registered tool (or none -> normal chat).
# Tools keep their validation and approval gates; personal content never
# reaches the planner model. KIRA_PLANNER_PROVIDER=gemini uses the cloud
# for planning (only with KIRA_CLOUD_AI=1); default is the local model.
# KIRA_PLANNER=1
# KIRA_PLANNER_PROVIDER=gemini

# Chat brain selection: auto (default; local first, Gemini rescue),
# gemini (Gemini first — best answers when the local model is weak),
# ollama (never use the cloud for chat).
# KIRA_CHAT_PROVIDER=gemini

# ----------------------------------------------------------------------------
# SECURITY — never add these
# ----------------------------------------------------------------------------
# KIRA only ever uses the PUBLIC anon/publishable key above.
#
# DO NOT add SUPABASE_SERVICE_ROLE_KEY (or any other service_role / secret /
# admin key) here or anywhere else. It bypasses Row Level Security and gives
# full read/write access to your whole project.
#
# If KIRA detects such a key in the environment it is IGNORED and a warning is
# logged; if it is placed in SUPABASE_ANON_KEY, KIRA refuses to connect.
# ============================================================================
